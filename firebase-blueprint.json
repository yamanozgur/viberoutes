{
  "entities": {
    "articles": {
      "title": "Articles",
      "description": "Editorial magazine articles and cultural dossiers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "homeSection": { "type": "string" },
        "coverImage": { "type": "string" },
        "coverImageCaption": { "type": "string" },
        "region": { "type": "string" },
        "readTime": { "type": "string" },
        "publishedAt": { "type": "string" },
        "featured": { "type": "boolean" },
        "hotel": { "type": "object" },
        "author": { "type": "object" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "views": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "coverImage"]
    },
    "users": {
      "title": "Users",
      "description": "Registered editorial staff and administrators",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor", "reader"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "editorial_logs": {
      "title": "Editorial Logs",
      "description": "Audit trail of editorial publishing actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "editorEmail": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "type", "message"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /articles/{articleId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n    match /users/{userId} {\n      allow read: if true;\n      allow write: if request.auth != null && (request.auth.uid == userId || resource.data.role == 'admin');\n    }\n    match /editorial_logs/{logId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n  }\n}"
}
